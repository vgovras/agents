{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortImports": {
    "groups": [
      ["value-builtin", "value-external"],
      ["value-internal", "value-parent", "value-sibling", "value-index"],
      "type-import",
      "unknown"
    ]
  },
  "ignorePatterns": [
    "dist/**",
    "drizzle/**",
    "pnpm-lock.yaml",
    "coverage/**",
    ".agents/**",
    ".claude/**",
    "tasks/**",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md"
  ]
}
