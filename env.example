# Copy to .env (git-ignored). Plain values, no quotes. Read by `make skill tui` when installing MCP servers.

# Optional Context7 API key (https://context7.com/dashboard). Empty = anonymous access.
# Claude Code: stored in the server's headers at install time.
# Codex: sent as a bearer token read from this env var at runtime, so also export it in your shell.
CONTEXT7_API_KEY=
